@model DCSProject.Models.GameInfo
@{
	ViewData["Title"] = Model.Title;
}

<!--Link that returns the user back to the games list. Only appears if there is more than one game in the catalog-->
<!--&larr creates a left arrrow character-->
@if (ViewBag.MoreThanOneGame == true)
{
	<a asp-controller="Games" asp-action="Index">&larr; All Games</a>
}

<!--Messages set by the controller (TempData lasts for one page load)-->
@if (TempData["Message"] != null)
{
	<div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">@TempData["Error"]</div>
}

<!--Only shown to signed-in Admins-->
@if (User.IsInRole("Admin"))
{
	<div class="float-end d-flex gap-2">
		<a class="btn btn-outline-primary btn-sm" asp-controller="Games" asp-action="Edit" asp-route-id="@Model.GameId">Edit</a>

		<!--Delete is a small form (POST) with the game's id. The confirm text is fixed on purpose: never put typed-in data inside JavaScript-->
		<form asp-controller="Games" asp-action="Delete" asp-route-id="@Model.GameId" method="post"
			  onsubmit="return confirm('Delete this game? This cannot be undone.');">
			<button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
		</form>

		<a class="btn btn-outline-primary btn-sm" asp-controller="Games" asp-action="Add">Add a Game</a>
	</div>
}

<!--Top Of the page: Game title and artwork-->
<div class="text-center">
	<h1 class="display-4">@Model.Title</h1>

	<img src="@Model.HeaderImageUrl"
		 alt="@Model.Title artwork"
		 class="img-fluid my-3" />

	<a href="@Model.SteamUrl" target="_blank" class="btn btn-primary btn-lg">View on Steam</a> 
</div>

<!--About the Game-->
<h2>About the Game</h2>
<p>@Model.Description</p>

<!--Quick Game facts-->
<h2>Quick Facts</h2>
<ul>
	<li>Developer: @Model.Developer</li>
	<li>Release Date: @Model.ReleaseDate.ToString("MMMM d, yyyy")</li>
	<li>Price: $@Model.Price</li>
	<li>Platform: @Model.Platform</li>
	<li>Players: @Model.PlayerCount</li>
</ul>

